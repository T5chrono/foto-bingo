{
  // Ten plik jest rozdzielnikiem dla `tsc -b` — prawdziwe ustawienia frontu
  // i backendu siedza w tsconfig.app.json i tsconfig.node.json.
  //
  // compilerOptions ponizej istnieja dla VERCELA, nie dla nas. Jego builder
  // kompiluje api/ wlasnym przebiegiem i czyta wylacznie ten plik; bez
  // "strict" zawezanie unii po polu rozroznajacym (done, ok) przestaje
  // dzialac i kompilacja pada na kodzie, ktory lokalnie przechodzi.
  // Referencje ponizej pilnuja, zeby te opcje nie mialy wplywu na nasz build.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ]
}
